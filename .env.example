# ─── Base de datos (docker-compose) ───
POSTGRES_USER=pokemon
POSTGRES_PASSWORD=pokemon
POSTGRES_DB=pokemon_cards
# Host corre en 55432 porque el 5432 suele estar ocupado por un Postgres local.
# Dentro del contenedor el puerto sigue siendo 5432.

# ─── Backend (backend/.env) ───
DATABASE_URL=postgresql://pokemon:pokemon@localhost:55432/pokemon_cards
REDIS_URL=redis://localhost:6379
PORT=3001
FRONTEND_URL=http://localhost:3000
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-too-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# ─── Frontend (frontend/.env.local) ───
NEXT_PUBLIC_API_URL=http://localhost:3001/api
# Poné 1 para que el OCR vuelva a bajar wasm/traineddata del CDN en vez de
# usar los assets auto-hospedados de public/tesseract (fase 6, offline).
# NEXT_PUBLIC_TESSERACT_CDN=1

# ─── Fuentes de datos ───
# Los precios salen de tcgdex.dev, que no necesita key: no hay nada que
# configurar. El set de cada carta se mapea solo contra tcgdex la primera vez
# que se pide un precio (card_sets.tcgdexSetId). Para re-mapear todo a mano:
#   pnpm --dir backend run db:map-tcgdex

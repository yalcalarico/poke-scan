# ─── Base de datos (docker-compose) ───
POSTGRES_USER=pokemon
POSTGRES_PASSWORD=pokemon
POSTGRES_DB=pokemon_cards
# Host corre en 55432 porque el 5432 suele estar ocupado por un Postgres local.
# Dentro del contenedor el puerto sigue siendo 5432.

# ─── Backend (backend/.env) ───
DATABASE_URL=postgresql://pokemon:pokemon@localhost:55432/pokemon_cards
REDIS_URL=redis://localhost:6379
PORT=3001
FRONTEND_URL=http://localhost:3000
# Solo desarrollo. Para deploy generá valores independientes con openssl rand -hex 32.
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-too-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# ─── Frontend (frontend/.env.local) ───
NEXT_PUBLIC_API_URL=http://localhost:3001/api
# Poné 1 para que el OCR vuelva a bajar wasm/traineddata del CDN en vez de
# usar los assets auto-hospedados de public/tesseract (fase 6, offline).
# NEXT_PUBLIC_TESSERACT_CDN=1

# ─── Fuentes de datos ───
# Los precios salen de tcgdex.dev, que no necesita key: no hay nada que
# configurar. El set de cada carta se mapea solo contra tcgdex la primera vez
# que se pide un precio (card_sets.tcgdexSetId). Para re-mapear todo a mano:
#   pnpm --dir backend run db:map-tcgdex

# ─── Base de datos de los tests ───
# Los specs corren contra esta, nunca contra la de desarrollo: derivan el nombre
# a <POSTGRES_DB>_test si no la definís. La creás una vez con
# `pnpm run test:db:setup`, que la arma como copia (varios specs dependen del
# catálogo espejado).
# Si no la definís y `DATABASE_URL` ya termina en _test, se usa esa.
# DATABASE_URL_TEST=postgresql://pokemon:pokemon@localhost:55432/pokemon_cards_test

# ─── Crons (backend/.env) ───
# Los tres jobs de mantenimiento se apagan con estas banderas. Vacío NO es
# apagado: una variable vacía cae al default, porque `VAR=` en un compose es más
# probable que sea un valor sin querer que una intención de apagar.
# ENABLE_CATALOG_SYNC_CRON=true    # sync del catálogo, lunes 04:07
# ENABLE_PRICE_BACKFILL_CRON=true   # backfill de precios, cada hora :13
# ENABLE_RETENTION_CRON=true       # consolidación de card_prices, mensual

# OCR progresivo experimental: mantener apagado hasta mejorar la medición real
NEXT_PUBLIC_SCANNER_PROGRESSIVE=0

# En producción FRONTEND_URL debe ser el origen HTTPS del frontend.
# Frontend y API deben compartir sitio para la cookie SameSite=Lax.
# CORS_ORIGINS=https://app.example.com

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PriceSyncSetOrigin {
  validated
  curated
  collection
  manual
}

enum PriceSyncQueueOrigin {
  legacy
  daily
  interactive
}

enum PriceSyncSetDayStatus {
  pending
  running
  waiting_feed
  waiting_cooldown
  completed
  partial
  blocked_mapping
  no_new_feed
  failed
  missed
}

enum PriceSyncCardDayStatus {
  pending
  processing
  quoted
  no_quote
  unsupported
  unmapped
  no_new_feed
  failed
  missed
}

// ─── Usuarios y sesiones ───

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  username     String  @unique
  passwordHash String
  authVersion  Int     @default(0)
  displayName  String
  avatarUrl    String?

  // Moneda preferida (fase 7: precios en ARS)
  preferredCurrency String? @default("USD") // 'USD' | 'ARS'
  preferredRateType String? @default("blue") // 'blue' | 'oficial'

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens RefreshToken[]
  passwordRecoveryTokens PasswordRecoveryToken[]
  collections   Collection[]
  shareLinks    ShareLink[]
  scanJobs      ScanJob[]
  portfolioSnapshots PortfolioSnapshot[]
  collectionItemAddOperations CollectionItemAddOperation[]

  // Fase 8: sistema de amigos. Cada Friendship es un par (requester, addressee)
  // con un único estado; las dos relaciones inversas permiten consultar
  // "amigos" y "solicitudes recibidas" sin queries extra.
  friendshipRequests Friendship[] @relation("FriendshipRequests")
  friendshipReceives Friendship[] @relation("FriendshipReceives")

  @@map("users")
}

model PasswordRecoveryToken {
  id                 String    @id @default(uuid())
  userId             String
  tokenHash          String    @unique
  issuedAuthVersion  Int
  expiresAt          DateTime
  usedAt             DateTime?
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@map("password_recovery_tokens")
}

model RecoveryRateLimitHit {
  id          String   @id @default(uuid())
  scope       String
  keyHash     String
  occurredAt  DateTime @default(now())
  @@index([scope, keyHash, occurredAt])
  @@map("recovery_rate_limit_hits")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  deviceInfo String?
  issuedAuthVersion Int @default(0)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ─── Catálogo local de cartas (espejo de pokemontcg.io) ───

model CardSet {
  id           String    @id // p.ej. "swsh4"
  name         String
  series       String?
  printedTotal Int?
  total        Int?
  releaseDate  DateTime?
  logoUrl      String?
  symbolUrl    String?
  // Código de 3 caracteres impreso en la esquina inferior izquierda de la carta
  // ("30C"). Es lo más barato que hay para saber de qué set es: texto contra
  // vocabulario cerrado, sin comparar imágenes. Solo los sets modernos lo
  // imprimen, y un par set/sub-producto lo comparte (me55 y me55c, "30C").
  ptcgoCode    String?
  rawJson      Json?
  syncedAt     DateTime  @default(now())

  // ID del set equivalente en tcgdex (la fuente de precios). Null = sin mapear:
  // lo resuelve TcgdexSetMappingService la primera vez que se pide un precio.
  tcgdexSetId String?

  cards       Card[]
  externalIds CardSetExternalId[]
  tcgcsvGroups TcgcsvSetGroup[]
  priceSyncSet PriceSyncSet?
  priceSyncSetDays PriceSyncSetDay[]
  priceSyncCardDays PriceSyncCardDay[]

  @@index([name])
  @@index([ptcgoCode])
  @@map("card_sets")
}

model Card {
  id             String   @id // p.ej. "swsh4-25"
  name           String
  supertype      String // Pokémon | Trainer | Energy
  subtypes       String[]
  hp             String?
  types          String[]
  number         String // p.ej. "25"
  rarity         String?
  artist         String?
  setId          String
  imageSmall     String
  imageLarge     String
  regulationMark String?
  language       String?  @default("en")

  // JSON original de la API: preserva ataques, habilidades, legalidades, etc.
  rawJson  Json
  syncedAt DateTime @default(now())

  set         CardSet          @relation(fields: [setId], references: [id], onDelete: Cascade)
  prices      CardPrice[]
  items       CollectionItem[]
  externalIds CardExternalId[]
  priceSyncCardDays PriceSyncCardDay[]

  @@index([name])
  @@index([setId])
  @@index([number])
  @@map("cards")
}

// ─── Precios (histórico) ───

model CardPrice {
  id        String   @id @default(uuid())
  cardId    String
  variant   String // normal | holofoil | reverseHolofoil | firstEditionNormal | firstEditionHolofoil
  low       Decimal? @db.Decimal(12, 2)
  mid       Decimal? @db.Decimal(12, 2)
  high      Decimal? @db.Decimal(12, 2)
  market    Decimal? @db.Decimal(12, 2)
  provider  String? // API que entregó el precio; null = fila histórica sin procedencia verificable
  source    String   @default("tcgplayer") // mercado/listing, distinto del proveedor de API
  currency  String   @default("USD")
  fetchedAt DateTime @default(now())
  feedPublishedAt DateTime?
  upstreamUpdatedAt DateTime?
  externalGroupId Int?
  externalProductId Int?
  externalSubtype String?
  ingestionRunId String?
  ingestionChecksum String?

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, variant, fetchedAt])
  @@index([cardId, provider, source, variant, fetchedAt])
  @@map("card_prices")
}

// IDs externos separados de las PK canónicas que ya usan las colecciones.
model CardExternalId {
  provider   String
  externalId String
  cardId     String
  createdAt  DateTime @default(now())

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@id([provider, externalId])
  @@index([cardId, provider])
  @@map("card_external_ids")
}

model CardSetExternalId {
  provider   String
  externalId String
  setId      String
  createdAt  DateTime @default(now())

  set CardSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@id([provider, externalId])
  @@index([setId, provider])
  @@map("card_set_external_ids")
}

// ─── Colecciones ───

model Collection {
  id        String   @id @default(uuid())
  userId    String
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      CollectionItem[]
  shareLinks ShareLink[]
  comparisonSnapshots CollectionComparisonSnapshot[]

  @@index([userId])
  @@map("collections")
}

model PortfolioSnapshot {
  userId String
  day DateTime @db.Date
  valueUsd Float?
  totalCards Int
  unpricedCards Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@map("portfolio_snapshots")
}

model CollectionItem {
  id           String   @id @default(uuid())
  collectionId String
  cardId       String
  variant      String   @default("normal")
  condition    String   @default("NM") // NM | LP | MP | HP | DM
  quantity     Int      @default(1) // > 1 = duplicada
  isForTrade   Boolean  @default(false)
  notes        String?
  addedAt      DateTime @default(now())
  updatedAt    DateTime @updatedAt

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  card       Card       @relation(fields: [cardId], references: [id], onDelete: Cascade)

  // Evita filas duplicadas: el mismo increment de cantidad se resuelve en el service
  @@unique([collectionId, cardId, variant, condition])
  @@index([collectionId])
  @@index([cardId])
  @@map("collection_items")
}

model CollectionItemAddOperation {
  userId      String
  key         String
  payloadHash String
  resultItemId String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
  @@index([expiresAt])
  @@map("collection_item_add_operations")
}

// ─── Compartir ───

model ShareLink {
  id           String    @id @default(uuid())
  userId       String
  collectionId String? // null = todas las colecciones del usuario
  slug         String    @unique
  isActive     Boolean   @default(true)
  viewCount    Int       @default(0)
  createdAt    DateTime  @default(now())
  expiresAt    DateTime?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  collection Collection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("share_links")
}

// ─── Tracking de jobs de sincronización ───
model ScanJob {
  id          String    @id @default(uuid())
  userId      String
  status      String    @default("pending") // pending | running | completed | failed
  jobType     String    @default("sync-catalog") // sync-catalog | refresh-prices
  processed   Int       @default(0)
  total       Int?
  lastError   String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("scan_jobs")
}

// ─── Cola de refresco de precios (Fase 4 de docs/plans/02-backend-production.md) ───

/// Una fila por carta que espera refresco de precios.
///
/// Es la cola que antes vivía en un array del proceso (`SyncPricesService.queue`).
/// La diferencia que importa no es "no perder la cola al reiniciar": es que
/// **`lastProviderCallAt` también era del proceso**, así que con dos instancias
/// el `MIN_GAP_MS` se contaba dos veces y el ritmo real hacia el proveedor se
/// duplicaba. Con la fila en Postgres, el ritmo es global.
///
/// El `@@unique` de `cardId` es la deduplicación: no hay `deduplicationKey`
/// porque el refresh no es por variante (un request trae todas), así que la
/// carta es la única clave.
///
/// `availableAt` es el backoff y también el reloj del claim: una fila `pending`
/// con `availableAt` en el futuro no se toca hasta que llegue. Un encolado
/// **nunca adelanta** un backoff (`GREATEST` en el upsert): si no, una lectura
/// stale-while-revalidate repetida se convertiría en un lazo de reintentos
/// contra una carta que el proveedor no tiene.
///
/// `lockedBy`/`lockedAt` son el claim. `SKIP LOCKED` hace que dos instancias no
/// puedan tomar la misma fila, y `lockedAt` es lo que permite recuperar en el
/// arranque los `processing` que quedaron colgados.
model PriceRefreshJob {
  id          String    @id @default(uuid())
  cardId      String    @unique
  status      String    @default("pending") // pending | processing | completed | failed
  attempts    Int       @default(0)
  availableAt DateTime  @default(now())
  lastError   String?
  lockedBy    String?
  lockedAt    DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  origin      PriceSyncQueueOrigin @default(legacy)
  syncDate    DateTime? @db.Date

  // El claim ordena por `availableAt` entre filas `pending`: sin este índice es
  // un seq scan con `ORDER BY` + `LIMIT 1` sobre toda la tabla.
  @@index([status, availableAt])
  // La recuperación de `processing` colgados en el arranque filtr por edad.
  @@index([status, lockedAt])
  @@index([origin, syncDate, status, availableAt])
  @@map("price_refresh_jobs")
}

/// El reloj global del ritmo hacia un proveedor de precios.
///
/// Una fila por proveedor, actualizada con un `UPDATE ... WHERE "lastCalledAt"
/// <= now() - intervalo`. Si el `UPDATE` no matchea, el slot está tomado: el
/// que espere calcula cuánto falta y duerme eso, en vez de hacer un `SELECT` en
/// bucle.
///
/// Sin esta tabla el gap es un `Date.now()` en memoria, y un `Date.now()` en
/// memoria es un gap por proceso. Es la diferencia entre "cortés" y "cumple la
/// cuota" en cuanto haya dos instancias.
model ProviderRateLimit {
  providerId   String   @id
  lastCalledAt DateTime
  updatedAt    DateTime @updatedAt
  blockedUntil DateTime?

  @@map("provider_rate_limits")
}

/// Cursor de los syncs de catálogo, por job **y** por proveedor.
///
/// Antes eran dos claves Redis sin TTL (`sync:cards:lastPage`,
/// `sync:cards:complete`) con granularidad global: un `flushall` reiniciaba el
/// sync desde la página 1 y hacía re-traer las 83 páginas de un catálogo que ya
/// estaba completo.
///
/// El id es composed (`<jobType>:<providerId>`) y no un `uuid`, porque la fila
/// tiene que ser la misma para el próximo sync del mismo job y proveedor: es un
/// checkpoint, no un registro. Cuando entre un segundo proveedor de catálogo, no
/// comparte cursor con pokemontcg.io.
model SyncState {
  id         String   @id // "cards:pokemontcg.io"
  lastPage   Int      @default(0)
  totalPages Int?
  isComplete Boolean  @default(false)
  updatedAt  DateTime @updatedAt

  @@map("sync_state")
}

// ─── Amigos (fase 8) ───

/// Una fila por par (requester, addressee) orientado. El @@unique garantiza
/// que no haya dos filas del mismo par en el mismo sentido, y el service
/// busca siempre en ambos sentidos para que el par tenga un único estado.
model Friendship {
  id          String    @id @default(uuid())
  requesterId String
  addresseeId String
  status      String    @default("pending") // pending | accepted | rejected | blocked
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  respondedAt DateTime?

  requester User @relation("FriendshipRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipReceives", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
  @@map("friendships")
}


// El presupuesto permanece aunque el proceso muera durante la descarga.
model TcgcsvDailyBatch {
  syncDate DateTime @id @db.Date
  openedAt DateTime @default(now())
  setIds String[]
  status String @default("planning")
  feedPublishedAt DateTime?
  feedAttempts Int @default(0)
  nextAttemptAt DateTime?
  finishedAt DateTime?
  lastError String?
  groups TcgcsvBatchGroup[]
  @@map("tcgcsv_daily_batches")
}

model TcgcsvBatchGroup {
  syncDate DateTime @db.Date
  groupId Int
  setIds String[]
  status String @default("pending")
  attempts Int @default(0)
  nextAttemptAt DateTime?
  startedAt DateTime?
  finishedAt DateTime?
  lastError String?
  batch TcgcsvDailyBatch @relation(fields: [syncDate], references: [syncDate], onDelete: Cascade)
  @@id([syncDate, groupId])
  @@index([syncDate, status, nextAttemptAt])
  @@map("tcgcsv_batch_groups")
}

model TcgcsvGroupJob {
  groupId Int @id
  status String @default("pending")
  availableAt DateTime @default(now())
  lockedBy String?
  leaseUntil DateTime?
  downloadStartedAt DateTime?
  publishedBuild DateTime?
  lastError String?
  updatedAt DateTime @default(now()) @updatedAt
  origin PriceSyncQueueOrigin @default(legacy)
  syncDate DateTime? @db.Date
  @@index([status, availableAt])
  @@index([origin, syncDate, status, availableAt])
  @@map("tcgcsv_group_jobs")
}

model PriceSyncSet {
  setId        String @id
  enabled      Boolean @default(true)
  priority     Int @default(100)
  origin       PriceSyncSetOrigin
  activatedAt  DateTime @default(now())
  lastDemandAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  set CardSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@index([enabled, priority, setId])
  @@map("price_sync_sets")
}

model PriceSyncSetDay {
  provider         String
  setId            String
  syncDate         DateTime @db.Date
  status           PriceSyncSetDayStatus @default(pending)
  expectedCards    Int @default(0)
  nextAttemptAt    DateTime?
  startedAt        DateTime?
  finishedAt       DateTime?
  lastError        String?
  feedPublishedAt  DateTime?
  sourceCheckedAt  DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  set CardSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@id([provider, setId, syncDate])
  @@index([provider, syncDate, status, nextAttemptAt])
  @@map("price_sync_set_days")
}

model PriceSyncCardDay {
  provider   String
  cardId     String
  setId      String
  syncDate   DateTime @db.Date
  status     PriceSyncCardDayStatus @default(pending)
  checkedAt  DateTime?
  quoteCount Int @default(0)
  attempts   Int @default(0)
  lastError  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  set  CardSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@id([provider, cardId, syncDate])
  @@index([provider, setId, syncDate, status])
  @@map("price_sync_card_days")
}

// Descubrimiento y cuotas compartidos entre procesos; no son corridas de precios.
model TcgcsvDiscoveryState {
  id String @id
  workerLockedBy String?
  workerLeaseUntil DateTime?
  nextCheckAt DateTime @default(now())
  lockedBy String?
  leaseUntil DateTime?
  groupsBuild DateTime?
  groupsJson Json?
  report Json?
  lastError String?
  requestWindowStartedAt DateTime @default(now())
  requestCount Int @default(0)
  downloadWindowStartedAt DateTime @default(now())
  downloadCount Int @default(0)
  updatedAt DateTime @default(now()) @updatedAt
  @@map("tcgcsv_discovery_state")
}

model PriceSyncControl {
  provider String @id
  requestedGeneration Int @default(0)
  handledGeneration Int @default(0)
  lastHandledAt DateTime?
  heartbeatAt DateTime?
  schedulerEnabled Boolean @default(false)
  workerConfiguredEnabled Boolean @default(false)
  lockedBy String?
  leaseUntil DateTime?
  nextCycleAt DateTime @default(now())
  lastError String?
  @@map("price_sync_controls")
}

model PriceIngestionRun {
  id String @id
  provider String
  groupId Int
  feedPublishedAt DateTime
  checksum String
  publishedAt DateTime
  mappedCards Int
  unmappedCards Int
  observations Int
  @@unique([provider, groupId, feedPublishedAt])
  @@map("price_ingestion_runs")
}

// Sólo productos: los precios y la publicación siempre se consultan en su ciclo reservado.
model TcgcsvProductCache {
  groupId Int @id
  content String @db.Text
  checksum String @db.VarChar(64)
  contentBytes Int
  etag String?
  lastModified String?
  receivedAt DateTime
  validatedAt DateTime

  @@map("tcgcsv_product_cache")
}

// Una fila por intento HTTP; no almacena cuerpos, credenciales ni errores arbitrarios.
model TcgcsvHttpRequest {
  id String @id @default(uuid())
  path String
  file String
  groupId Int?
  requestedAt DateTime @default(now())
  status Int?
  receivedBytes Int
  durationMs Int
  conditional Boolean
  reusedCache Boolean
  retryAfterMs Float?
  outcome String

  @@index([requestedAt, file])
  @@index([groupId, requestedAt])
  @@map("tcgcsv_http_requests")
}

model CollectionComparisonSnapshot {
  collectionId String
  provider String
  policy String
  day DateTime @db.Date
  valueUsd Decimal? @db.Decimal(20, 2)
  totalCopies Int
  pricedCopies Int
  freshCopies Int
  staleCopies Int
  unknownFreshnessCopies Int
  oldestFetchedAt DateTime?
  newestFetchedAt DateTime?
  feedPublishedAt DateTime?
  compositionFingerprint String
  compositionChanged Boolean
  scopeCount Int
  snapshotCut String
  evaluatedAt DateTime
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  @@id([collectionId, provider, policy, day])
  @@index([day, provider, policy])
  @@map("collection_comparison_snapshots")
}

model TcgcsvSetGroup {
  groupId Int
  setId String
  createdAt DateTime @default(now())
  set CardSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  @@id([groupId, setId])
  @@index([setId])
  @@map("tcgcsv_set_groups")
}

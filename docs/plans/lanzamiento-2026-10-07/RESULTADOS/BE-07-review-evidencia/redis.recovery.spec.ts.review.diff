+// Servidor RESP mínimo: el cliente y el parser son ioredis reales. El servidor
+// retiene una respuesta de SET y corta el socket, sin Redis/DB compartidos.
+function readCommands(data: string): {
+  commands: string[][];
+  remaining: string;
+} {
+  const commands: string[][] = [];
+  let offset = 0;
+  while (offset < data.length) {
+    const start = offset;
+    const end = data.indexOf('\r\n', offset);
+    if (end < 0) break;
+    const count = Number(data.slice(offset + 1, end));
+    if (data[offset] !== '*' || !Number.isInteger(count) || count < 1)
+      throw new Error('RESP inesperado');
+    offset = end + 2;
+    const args: string[] = [];
+    for (let i = 0; i < count; i += 1) {
+      const lengthEnd = data.indexOf('\r\n', offset);
+      if (lengthEnd < 0) break;
+      const size = Number(data.slice(offset + 1, lengthEnd));
+      if (data[offset] !== '$' || !Number.isInteger(size) || size < 0)
+        throw new Error('Bulk RESP inesperado');
+      if (data.length < lengthEnd + 2 + size + 2) break;
+      args.push(data.slice(lengthEnd + 2, lengthEnd + 2 + size));
+      offset = lengthEnd + 2 + size + 2;
+    }
+    if (args.length !== count) {
+      offset = start;
+      break;
+    }
+    commands.push(args);
+  }
+  return { commands, remaining: data.slice(offset) };
+}
+
+async function eventually(
+  predicate: () => boolean,
+  timeout = 5000,
+): Promise<void> {
+  const deadline = Date.now() + timeout;
+  while (!predicate()) {
+    if (Date.now() > deadline)
+      throw new Error('No llegó la transición esperada');
+    await new Promise((resolve) => setTimeout(resolve, 10));
+  }
+}

+
+  it.each(['connecting', 'reconnecting', 'ready'])(
+    'shutdown en %s resuelve connect y termina el socket sin retry',
+    async (phase) => {
+      if (phase === 'connecting') {
+        mode = 'connecting';
+        await eventually(
+          () =>
+            sockets.size === 1 &&
+            (harness.client as { status: string }).status === 'connect',
+        );
+      } else {

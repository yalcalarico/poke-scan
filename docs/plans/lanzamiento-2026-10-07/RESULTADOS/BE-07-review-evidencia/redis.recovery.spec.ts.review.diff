+describe('RedisService — ioredis real con corte de socket propio', () => {
+  let server: Server;
+  let service: RedisService;
+  let sockets: Set<Socket>;
+  let writes: number;
+  let mode: 'replay' | 'connecting' | 'blackhole';
+  let logs: ReturnType<typeof observe>;
+  beforeEach(async () => {
+    harness.real = true;
+    sockets = new Set();
+    writes = 0;
+    mode = 'replay';
+    server = createServer((socket) => {
+      sockets.add(socket);
+      socket.on('error', () => {});
+      socket.on('close', () => sockets.delete(socket));
+      let pending = '';
+      socket.on('data', (chunk) => {
+        pending += chunk.toString();
+        const result = readCommands(pending);
+        pending = result.remaining;
+        for (const args of result.commands) {
+          if (
+            mode === 'connecting' ||
+            (mode === 'blackhole' && args[0]?.toLowerCase() === 'get')
+          )
+            continue;
+          if (args[0]?.toLowerCase() === 'set') {
+            writes += 1;
+            if (writes === 1) {
+              socket.destroy();
+              continue;
+            }
+          }
+          if (args[0]?.toLowerCase() === 'info') {
+            const info = 'loading:0\r\n';
+            socket.write(`$${info.length}\r\n${info}\r\n`);
+          } else socket.write('+OK\r\n');
+        }
+      });
+    });
+    await new Promise<void>((resolve, reject) => {
+      server.once('error', reject);
+      server.listen(0, '127.0.0.1', resolve);
+    });
+    const address = server.address();
+    if (!address || typeof address === 'string')
+      throw new Error('No hay puerto TCP propio');
+    service = new RedisService({
+      get: () => `redis://127.0.0.1:${address.port}/15`,
+    } as unknown as ConfigService);
+    logs = observe(service);
+    service.onModuleInit();
+  });
+  afterEach(async () => {
+    await service?.onModuleDestroy();
+    for (const socket of sockets) socket.destroy();
+    if (server.listening)
+      await new Promise<void>((resolve) => server.close(() => resolve()));
+    harness.real = false;
+    vi.restoreAllMocks();
+  });
+

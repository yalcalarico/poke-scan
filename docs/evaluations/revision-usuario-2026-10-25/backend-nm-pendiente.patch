@@ -0,0 +1,45 @@
+BEGIN;
+
+-- Sólo se normaliza inventario; las observaciones históricas de precios quedan intactas.
+LOCK TABLE collection_items IN SHARE ROW EXCLUSIVE MODE;
+
+CREATE TEMP TABLE nm_item_mapping ON COMMIT DROP AS
+SELECT id,
+       FIRST_VALUE(id) OVER (
+         PARTITION BY "collectionId", "cardId", variant
+         ORDER BY (condition = 'NM') DESC, "addedAt", id
+       ) AS "canonicalId"
+FROM collection_items;
+
+CREATE TEMP TABLE nm_item_totals ON COMMIT DROP AS
+SELECT m."canonicalId", SUM(i.quantity) AS quantity,
+       BOOL_OR(i."isForTrade") AS "isForTrade",
+       STRING_AGG(DISTINCT NULLIF(i.notes, ''), E'\n' ORDER BY NULLIF(i.notes, '')) AS notes,
+       MIN(i."addedAt") AS "addedAt", MAX(i."updatedAt") AS "updatedAt"
+FROM collection_items i JOIN nm_item_mapping m ON m.id = i.id
+GROUP BY m."canonicalId";
+
+-- Si los atributos no caben, se conserva todo y se exige resolver el conflicto.
+DO $$
+BEGIN
+  IF EXISTS (SELECT 1 FROM nm_item_totals WHERE quantity > 2147483647 OR LENGTH(notes) > 500) THEN
+    RAISE EXCEPTION 'Normalización NM pendiente: una unión excede los límites de cantidad o notas. No se modificó el inventario.';
+  END IF;
+END $$;
+
+-- El replay conserva su hash original y resuelve al ítem que acumula las copias.
+UPDATE collection_item_add_operations o
+SET "resultItemId" = m."canonicalId"
+FROM nm_item_mapping m
+WHERE o."resultItemId" = m.id AND m.id <> m."canonicalId";
+
+DELETE FROM collection_items i USING nm_item_mapping m
+WHERE i.id = m.id AND m.id <> m."canonicalId";
+
+UPDATE collection_items i
+SET condition = 'NM', quantity = t.quantity::integer,
+    "isForTrade" = t."isForTrade", notes = t.notes,
+    "addedAt" = t."addedAt", "updatedAt" = t."updatedAt"
+FROM nm_item_totals t WHERE i.id = t."canonicalId";
+
+COMMIT;

+import assert from 'node:assert/strict';
+import { randomUUID } from 'node:crypto';
+import { spawnSync } from 'node:child_process';
+import { fileURLToPath } from 'node:url';
+import { PrismaClient } from '@prisma/client';
+
+const database = new URL(process.env.DATABASE_URL ?? '');
+assert.match(database.pathname, /_test$/);
+const cwd = fileURLToPath(new URL('../', import.meta.url));
+const prisma = new PrismaClient();
+const apply = () => spawnSync('pnpm', ['exec', 'prisma', 'db', 'execute', '--file', 'prisma/migrations/20261026020000_collection_nm_only/migration.sql', '--schema', 'prisma/schema.prisma'], { cwd, env: process.env, encoding: 'utf8' });
+const userIds = [];
+
+try {
+  const card = await prisma.card.findFirst({ select: { id: true } });
+  assert.ok(card, 'Falta catálogo local de pruebas');
+  for (const overflow of [false, true]) {
+    const user = await prisma.user.create({ data: { email: `${randomUUID()}@nm-qa.local`, username: `nmqa${randomUUID().replaceAll('-', '').slice(0, 12)}`, displayName: 'QA NM', passwordHash: 'qa-no-login' } });
+    userIds.push(user.id);
+    const collection = await prisma.collection.create({ data: { userId: user.id, name: 'Normalización NM QA' } });
+    const normal = await prisma.collectionItem.create({ data: { collectionId: collection.id, cardId: card.id, condition: 'NM', quantity: 2, notes: overflow ? 'a'.repeat(300) : 'nota NM', addedAt: new Date('2026-01-02') } });
+    const legacy = await prisma.collectionItem.create({ data: { collectionId: collection.id, cardId: card.id, condition: 'HP', quantity: 3, notes: overflow ? 'b'.repeat(300) : 'nota HP', isForTrade: true, addedAt: new Date('2026-01-01') } });
+    const key = randomUUID();
+    await prisma.collectionItemAddOperation.create({ data: { userId: user.id, key, payloadHash: 'legacy-hash-sin-cambiar', resultItemId: legacy.id, expiresAt: new Date(Date.now() + 86400000) } });
+    const prices = await prisma.cardPrice.count();
+    const migration = apply();
+    const rows = await prisma.collectionItem.findMany({ where: { collectionId: collection.id } });
+    const operation = await prisma.collectionItemAddOperation.findUniqueOrThrow({ where: { userId_key: { userId: user.id, key } } });
+    if (overflow) {
+      assert.notEqual(migration.status, 0, 'Debió rechazar notas que no caben');
+      assert.equal(rows.length, 2);
+      assert.equal(rows.find((row) => row.id === legacy.id)?.condition, 'HP');
+      assert.equal(operation.resultItemId, legacy.id);
+      console.log('Rollback por conflicto de notas: OK, sin pérdida de filas ni referencias');
+    } else {
+      assert.equal(migration.status, 0, migration.stderr);
+      assert.equal(rows.length, 1);
+      assert.equal(rows[0].id, normal.id);
+      assert.equal(rows[0].condition, 'NM');
+      assert.equal(rows[0].quantity, 5);
+      assert.equal(rows[0].isForTrade, true);
+      assert.ok(rows[0].notes.includes('nota NM') && rows[0].notes.includes('nota HP'));
+      assert.equal(rows[0].addedAt.toISOString().slice(0, 10), '2026-01-01');
+      assert.equal(operation.resultItemId, normal.id);
+      assert.equal(operation.payloadHash, 'legacy-hash-sin-cambiar');
+      console.log('NM + HP → NM, 2 + 3 = 5; notas, intercambio, fecha y replay: OK');
+    }
+    assert.equal(await prisma.cardPrice.count(), prices);
+    await prisma.user.delete({ where: { id: user.id } });
+    userIds.splice(userIds.indexOf(user.id), 1);
+  }
+} finally {
+  for (const id of userIds) await prisma.user.deleteMany({ where: { id } });
+  await prisma.$disconnect();
+}
